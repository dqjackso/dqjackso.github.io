---
import type { SocialLink } from '../data/site';

interface Props {
  links: readonly SocialLink[];
}

const { links } = Astro.props;
---

<ul class="socials">
  {
    links.map((link) => (
      <li>
        <a href={link.href} rel="me noopener noreferrer">
          {link.icon === 'linkedin' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M4.6 3.2h14.8c.8 0 1.4.6 1.4 1.4v14.8c0 .8-.6 1.4-1.4 1.4H4.6c-.8 0-1.4-.6-1.4-1.4V4.6c0-.8.6-1.4 1.4-1.4zM8.05 10.05H6.2v7.3h1.85v-7.3zM7.12 6.55a1.12 1.12 0 1 0 .02 2.24 1.12 1.12 0 0 0-.02-2.24zM17.85 17.35h-1.85v-3.55c0-.86-.31-1.45-1.08-1.45-.59 0-.94.4-1.1 1.05-.06.14-.07.34-.07.54v3.41H11.9V10.05h1.85v1c.35-.54 1.05-1.18 2.32-1.18 1.7 0 2.78 1.11 2.78 3.5v3.98z"
              />
            </svg>
          )}
          {link.icon === 'instagram' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none">
              <rect x="3.4" y="3.4" width="17.2" height="17.2" rx="5" stroke="currentColor" stroke-width="1.7" />
              <circle cx="12" cy="12" r="4.05" stroke="currentColor" stroke-width="1.7" />
              <circle cx="17.25" cy="6.75" r="1.05" fill="currentColor" />
            </svg>
          )}
          {link.icon === 'facebook' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M14.35 8.15h2.15V5.4h-2.4C11.8 5.4 10.3 6.85 10.3 9.15v1.55H8.15v2.7h2.15V19h2.65v-5.6h2.15l.35-2.7h-2.5V9.35c0-.62.32-1.2 1.4-1.2z"
              />
            </svg>
          )}
          {link.icon === 'github' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M12 2.2a9.8 9.8 0 0 0-3.1 19.1c.49.1.67-.21.67-.47v-1.64c-2.72.59-3.3-1.31-3.3-1.31-.44-1.13-1.08-1.43-1.08-1.43-.89-.6.07-.59.07-.59.98.07 1.5 1.01 1.5 1.01.87 1.5 2.29 1.06 2.85.81.09-.63.34-1.06.62-1.31-2.17-.25-4.46-1.09-4.46-4.84 0-1.07.38-1.94 1.01-2.63-.1-.25-.44-1.25.1-2.61 0 0 .82-.26 2.7 1a9.3 9.3 0 0 1 4.92 0c1.87-1.26 2.69-1 2.69-1 .54 1.36.2 2.36.1 2.61.63.69 1.01 1.56 1.01 2.63 0 3.76-2.29 4.59-4.47 4.83.35.3.66.9.66 1.82v2.7c0 .26.18.57.68.47A9.8 9.8 0 0 0 12 2.2z"
              />
            </svg>
          )}
          <span class="sr-only">{link.label}</span>
        </a>
      </li>
    ))
  }
</ul>
