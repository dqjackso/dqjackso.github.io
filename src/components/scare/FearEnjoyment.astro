---
const points: string[] = [];
for (let i = 0; i <= 48; i += 1) {
  const t = i / 48;
  const x = 36 + t * 568;
  const u = (x - 320) / 284;
  const y = 248 - 188 * (1 - u * u);
  points.push(`${x.toFixed(1)},${y.toFixed(1)}`);
}
const d = `M ${points.join(' L ')}`;
---

<figure class="viz" id="viz-curve">
  <p class="chart-title">Fear and enjoyment</p>
  <div class="curve-stage">
    <p class="curve-y">Enjoyment</p>
    <div class="curve-plot">
      <svg class="curve" viewBox="0 0 640 280" role="img" aria-labelledby="curve-title curve-desc">
        <title id="curve-title">Conceptual inverted U of enjoyment against fear</title>
        <desc id="curve-desc">
          A sketch of enjoyment against fear. The curve peaks at f-star, the sweet spot, and falls off on both sides. The label on the shoulder marks that drop-off.
        </desc>
        <rect class="band" x="246" y="18" width="148" height="230" rx="16"></rect>
        <line class="axis" x1="28" y1="16" x2="28" y2="248"></line>
        <line class="axis" x1="28" y1="248" x2="612" y2="248"></line>
        <path class="line" pathLength="1" d={d}></path>
      </svg>
      <p class="curve-sweet">f*</p>
      <p class="curve-drop">falls off with b</p>
    </div>
  </div>
  <div class="curve-ticks">
    <span>low</span>
    <span>sweet spot</span>
    <span>high</span>
  </div>
  <p class="curve-x">Fear</p>
  <figcaption>
    A sketch of the curve the study describes. Enjoyment peaks when the fear is moderate.{' '}
    <a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC7734554/">Andersen et al., 2020</a>.
  </figcaption>
</figure>
