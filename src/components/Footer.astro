---
import SocialLinks from './SocialLinks.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-meta">
    <p>© {year} {site.name}</p>
    <a href="/rss.xml">RSS</a>
  </div>
  <SocialLinks links={site.socials} />
</footer>
