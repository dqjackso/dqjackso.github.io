---
import { Picture } from 'astro:assets';
import Base from '../components/Base.astro';
import { photos } from '../data/photos';
import { site } from '../data/site';
import { getSocialImage } from '../lib/social-image';

const social = await getSocialImage();
const imageUrl = new URL(social.src, Astro.site).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  description: site.tagline,
  image: imageUrl,
  sameAs: site.sameAs,
};

const tiles = [
  { photo: photos.about, className: 'frame-about' },
  { photo: photos.editorial, className: 'frame-editorial' },
  { photo: photos.friends, className: 'frame-friends' },
];
---

<Base
  title={site.name}
  description={site.description}
  image={social.src}
  imageAlt={photos.hero.alt}
  imageWidth={social.attributes.width}
  imageHeight={social.attributes.height}
  jsonLd={person}
>
  <section class="home-hero">
    <div class="hero">
      <h1>
        <span>Derek</span>
        <span class="surname">Jackson</span>
      </h1>
      <p class="tagline">{site.tagline}</p>
    </div>
    <figure class="hero-figure">
      <div class="frame frame-hero">
        <Picture
          src={photos.hero.src}
          alt={photos.hero.alt}
          widths={[360, 520, 704]}
          sizes="(min-width: 900px) 36rem, calc(100vw - 2.5rem)"
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          quality={80}
          layout="constrained"
          width={704}
          priority
        />
      </div>
    </figure>
  </section>

  <div class="photo-row">
    {
      tiles.map((tile) => (
        <figure>
          <div class:list={['frame', 'frame-tile', tile.className]}>
            <Picture
              src={tile.photo.src}
              alt={tile.photo.alt}
              widths={[480, 720, 960]}
              sizes="(min-width: 900px) 24rem, calc(100vw - 2.5rem)"
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              quality={75}
              layout="constrained"
              width={960}
            />
          </div>
        </figure>
      ))
    }
  </div>

  <section class="about-block">
    <h2>About</h2>
    <p class="bio">{site.bio}</p>
  </section>
</Base>
