---
import Base from '../components/Base.astro';
import { site } from '../data/site';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  description: site.tagline,
};
---

<Base title={site.name} description={site.description} jsonLd={person}>
  <section class="hero">
    <h1>
      <span>Derek</span>
      <span class="surname">Jackson</span>
    </h1>
    <p class="tagline">{site.tagline}</p>
  </section>

  <figure class="plate">
    <img
      src={site.portrait.src}
      alt={site.portrait.alt}
      width={site.portrait.width}
      height={site.portrait.height}
    />
    <figcaption>{site.portrait.caption}</figcaption>
  </figure>

  <section class="section">
    <h2 class="kicker">About</h2>
    <p class="bio">{site.bio}</p>
  </section>

  <section class="section">
    <h2 class="kicker">Links</h2>
    <ul class="link-list">
      {
        site.socials.map((social) => {
          const href = social.href?.trim();
          return (
            <li>
              {href ? (
                <a class="link-label" href={href}>
                  {social.label}
                </a>
              ) : (
                <span class="link-label">{social.label}</span>
              )}
              {href ? <span class="link-note">{href.replace(/^https?:\/\//, '')}</span> : <span class="link-note">{social.placeholder}</span>}
            </li>
          );
        })
      }
    </ul>
  </section>
</Base>
