---
import { render } from 'astro:content';
import Base from '../../components/Base.astro';
import ShareLinks from '../../components/ShareLinks.astro';
import { photos } from '../../data/photos';
import { site } from '../../data/site';
import { getSocialImage } from '../../lib/social-image';
import { formatDate, getPosts, getRenderablePosts, tagSlug, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getRenderablePosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const publishedTags = new Set(
  (await getPosts()).flatMap((entry) => entry.data.tags.map((tag) => tagSlug(tag))),
);
const canonical = new URL(`/blog/${post.id}/`, Astro.site);
const social = await getSocialImage();
const image = post.data.image ?? social.src;
const imageAlt = post.data.imageAlt ?? photos.hero.alt;
const modified = post.data.updatedDate ?? post.data.pubDate;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: modified.toISOString(),
  inLanguage: 'en',
  keywords: post.data.tags.join(', '),
  image: [new URL(image, Astro.site).href],
  mainEntityOfPage: canonical.href,
  author: {
    '@type': 'Person',
    name: site.name,
    url: site.url,
    sameAs: site.sameAs,
  },
};
---

<Base
  title={post.data.title}
  description={post.data.description}
  image={image}
  imageAlt={imageAlt}
  ogType="article"
  published={post.data.pubDate}
  modified={modified}
  tags={post.data.tags}
  noindex={post.data.draft}
  jsonLd={jsonLd}
>
  <article class="post" data-share-url={canonical.href} data-share-title={post.data.title}>
    {
      post.data.draft && (
        <p class="banner">Draft for review. This page is not listed on the blog, in the RSS feed, or in the sitemap.</p>
      )
    }
    <header class="post-head">
      <p class="kicker">Blog</p>
      <h1>{post.data.title}</h1>
      <p class="dek">{post.data.description}</p>
      <p class="meta">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      </p>
      {
        post.data.tags.length > 0 && (
          <ul class="tags">
            {post.data.tags.map((tag) => (
              <li>
                {publishedTags.has(tagSlug(tag)) ? (
                  <a href={`/blog/tags/${tagSlug(tag)}/`}>{tag}</a>
                ) : (
                  <span>{tag}</span>
                )}
              </li>
            ))}
          </ul>
        )
      }
      <ShareLinks url={canonical.href} title={post.data.title} />
    </header>
    <div class="prose">
      <Content />
    </div>
    <ShareLinks url={canonical.href} title={post.data.title} />
  </article>
</Base>
