---
import Base from '../../components/Base.astro';
import { formatDate, getPosts, tagSlug } from '../../lib/posts';

const posts = await getPosts();
const description = 'Blog by Derek Jackson.';
---

<Base title="Blog" description={description}>
  <header class="page-head">
    <p class="kicker">Notes</p>
    <h1>Blog</h1>
    <p class="lede">
      {posts.length > 0 ? 'Notes and essays.' : 'Essays will live here.'}
    </p>
  </header>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <article>
            <p class="meta">
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            </p>
            <h2>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
            {
              post.data.tags.length > 0 && (
                <ul class="tags">
                  {post.data.tags.map((tag) => (
                    <li>
                      <a href={`/blog/tags/${tagSlug(tag)}/`}>{tag}</a>
                    </li>
                  ))}
                </ul>
              )
            }
          </article>
        </li>
      ))
    }
  </ul>
</Base>
